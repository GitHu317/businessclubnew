// Prisma schema for Business Club at Kotebe University of Education
// Schema design is portable to PostgreSQL by switching the provider and datasource URL.
//
// ADVANCED SCHEMA — supports: rich-media lessons, embedded lesson quizzes,
// course tags + card ordering + prerequisites, multiple certificate types/designs,
// gamification (XP, levels, badges, collectibles), reviews & ratings,
// instructor applications + creator profiles, onboarding questionnaire,
// FAQ, board/admin chat, expanded assessment question types with grading,
// and super-admin audit-log management.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  fullName        String
  email           String   @unique
  passwordHash    String?  // nullable to support Google-only accounts
  studentId       String?
  department      String?
  role            String   @default("STUDENT") // STUDENT | ADMIN
  bodRole         String?  // PRESIDENT | BOD (only set for Board of Directors admin accounts)
  membershipStatus String @default("PENDING") // PENDING | ACTIVE | VERIFIED
  membershipTier  String   @default("BASIC") // BASIC | PREMIUM | HONORARY
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Google / Firebase auth
  googleId        String?  @unique
  avatarUrl       String?

  // Onboarding questionnaire (collected on first sign-in)
  hasOnboarded    Boolean  @default(false)
  heardAbout      String?  // how they heard about the site
  institution     String?  // school / institution
  usageGoals      String?  // free text usage goals

  // Creator / instructor profile
  creatorProfile  CreatorProfile?

  // Gamification
  xp              Int      @default(0)
  level           Int      @default(1)
  userBadges      UserBadge[]
  userCollectibles UserCollectible[]

  enrollments     Enrollment[]
  examAttempts    ExamAttempt[]
  certificates    Certificate[]
  gameRegistrations GameRegistration[]
  activityLogs    ActivityLog[]
  reviews         Review[]
  applications    InstructorApplication[]
  chatMessages    ChatMessage[]
}

// Audit trail for Board of Directors (BOD) actions across the admin panel.
// Logged actions include: LOGIN, LOGOUT, PAGE_VIEW, CREATE, UPDATE, DELETE.
model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  action        String   // LOGIN | LOGOUT | PAGE_VIEW | CREATE | UPDATE | DELETE | DELETE_LOG
  resourceType  String?  // e.g. BOARD_MEMBER, COURSE, EXAM, GAME, ANNOUNCEMENT, USER, CERTIFICATE, LOG
  resourceId    String?
  description   String?  // human-readable summary of the action
  ipAddress     String?
  userAgent     String?
  metadata      String?  // JSON string of extra context
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model BoardMember {
  id          String   @id @default(cuid())
  fullName    String
  title       String
  bio         String
  photoUrl    String?
  email       String?
  linkedin    String?
  twitter     String?
  instagram   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String   @default("Entrepreneurship")
  level        String   @default("Beginner") // Beginner | Intermediate | Advanced
  thumbnailUrl String?
  published    Boolean  @default(true)
  cardOrder    Int      @default(0) // ordering in catalog cards
  tags         String   @default("[]") // JSON array of tag strings, e.g. ["#business","#free"]
  // Prerequisite: a linked course that must be completed (certificate earned) first.
  prerequisiteId String? // points to another Course.id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // self-relation for prerequisites
  prerequisite   Course?  @relation("CoursePrerequisite", fields: [prerequisiteId], references: [id])
  dependents     Course[] @relation("CoursePrerequisite")

  // creator / instructor
  creatorId    String?
  creator      CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  lessons      Lesson[]
  exams        Exam[]
  enrollments  Enrollment[]
  certificates Certificate[]
  reviews      Review[]
}

// Creator / instructor profile — required before a user can publish a course.
model CreatorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  headline     String   // e.g. "Senior Lecturer, Business Department"
  bio          String
  expertise    String   @default("[]") // JSON array of expertise tags
  avatarUrl    String?
  credentials  String?  // free text: qualifications, experience
  approved     Boolean  @default(false) // admin must approve before publishing
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses      Course[]
}

// Application submitted by a non-admin user to become an approved course creator.
model InstructorApplication {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String?
  department     String?
  photoUrl       String?
  qualifications String
  experience     String
  proposedCourse String?
  website        String?
  bio            String?
  expertise      String?   
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
model Lesson {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  content     String   // markdown description / body
  videoUrl    String?  // YouTube / Vimeo / MP4
  videoType   String   @default("none") // none | youtube | vimeo | mp4
  order       Int      @default(0)
  durationMins Int     @default(10)
  // card layout ordering inside the course page (separate from sequential order)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  media       MediaAttachment[]
  quiz        LessonQuiz?
}

// Rich media attachments for a lesson — images, documents (PDF/docs), etc.
model MediaAttachment {
  id          String   @id @default(cuid())
  lessonId    String
  type        String   // image | document
  url         String
  filename    String?
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// An optional mini-quiz embedded inside a lesson (distinct from course exams).
model LessonQuiz {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  title       String   @default("Quick Check")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   LessonQuizQuestion[]
}

model LessonQuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  text        String
  type        String   @default("MCQ") // MCQ | TRUE_FALSE | FILL_BLANK
  options     String   @default("[]") // JSON array for MCQ
  answer      String   // correct answer text / index / "true"|"false"
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  quiz        LessonQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Enrollment {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  progress     Float    @default(0) // 0-100 percentage
  completed    Boolean  @default(false)
  enrolledAt   DateTime @default(now())
  completedAt  DateTime?
  xpAwarded    Boolean  @default(false) // whether completion XP was granted
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completed    Boolean  @default(false)
  completedAt  DateTime?
  xpAwarded    Boolean  @default(false)

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson        Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model Exam {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  description  String
  passingScore Int      @default(70) // percentage
  durationMins Int      @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     ExamAttempt[]
}

// Expanded question model supporting multiple formats.
model Question {
  id          String   @id @default(cuid())
  examId      String
  text        String
  type        String   @default("MCQ") // MCQ | TRUE_FALSE | FILL_BLANK | SHORT_ANSWER
  options     String   @default("[]") // JSON array of options (MCQ)
  correctIndex Int?    // MCQ only
  answer      String?  // TRUE_FALSE ("true"/"false"), FILL_BLANK (exact text), SHORT_ANSWER (model answer for manual grading)
  points      Int      @default(1)
  createdAt   DateTime @default(now())

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  answers     String   // JSON array of {questionId, value}
  score       Int      // percentage
  passed      Boolean
  status      String   @default("AUTO_GRADED") // AUTO_GRADED | PENDING_GRADE | GRADED
  startedAt   DateTime @default(now())
  submittedAt DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  certificate Certificate?
  grades      GradeResult[]
}

// Per-question grade for short-answer / manually graded questions.
model GradeResult {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  awarded      Int      @default(0) // points awarded
  feedback     String?  // admin feedback
  gradedBy     String?
  gradedAt     DateTime @default(now())

  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateId   String   @unique // public-facing unforgeable ID
  userId          String
  courseId        String
  examAttemptId   String?  @unique
  // Certificate type / design template
  type            String   @default("PROFESSIONAL") // PROFESSIONAL | MEMBER_ONLY
  issuedAt        DateTime @default(now())
  verificationHash String  @unique

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examAttempt     ExamAttempt? @relation(fields: [examAttemptId], references: [id])
}

model BusinessGame {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String   @default("SIMULATION") // SIMULATION | COMPETITION | CASE_CHALLENGE
  rules         String
  schedule      String
  status        String   @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED
  registrationOpen Boolean @default(true)
  registrationUrl String?
  announcement  String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  registrations GameRegistration[]
}

model GameRegistration {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  registeredAt DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        BusinessGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("GENERAL") // GENERAL | EVENT | GAME | COURSE
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Gamification ----

// Catalog of badges that users can earn.
model Badge {
  id          String   @id @default(cuid())
  key         String   @unique // stable identifier, e.g. "first_course"
  name        String
  description String
  iconUrl     String?
  xpRequired  Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// Catalog of collectible reward items (Pokémon-style).
model Collectible {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  iconUrl     String?
  rarity      String   @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY
  createdAt   DateTime @default(now())

  users       UserCollectible[]
}

model UserCollectible {
  id        String   @id @default(cuid())
  userId    String
  collectibleId String
  awardedAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)

  @@unique([userId, collectibleId])
}

// ---- Reviews & Feedback ----

model Review {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  rating      Int      // 1-5 stars
  comment     String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ---- FAQ ----

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Board / Admin Chat ----

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  channel     String   @default("board") // board | bod
  body        String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
}
